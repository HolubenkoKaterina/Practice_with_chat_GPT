products = {
    "coffee": {
        "price": 250,
        "quantity": 15
    },
    "tea": {
        "price": 120,
        "quantity": 30
    },
    "milk": {
        "price": 60,
        "quantity": 25
    }
}
products["coffee"]["quantity"] += 5
# print(products["coffee"]["quantity"])
products["tea"]["quantity"] -= 7
# print(products["tea"]["quantity"])
products["milk"]["price"] *= 1.1
# print(products["milk"]["price"])
# посчитай общую сумму продаж кофе: цена × количество
sales = products["coffee"]["price"] * products["coffee"]["quantity"]
products["coffee"]["sales"] = sales
# print(products["coffee"])
products["tea"]["sales"] = products["tea"]["quantity"] * products["tea"]["price"]
